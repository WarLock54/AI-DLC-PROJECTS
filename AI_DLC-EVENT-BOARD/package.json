{
  "name": "community-event-board",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Community Event Board shared AWS CDK foundation",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "lint": "eslint src test scripts ui",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"ui/**/*.{ts,css,html}\" \"*.json\"",
    "test:c1-foundation": "vitest run --coverage --config vitest.config.ts test/c1-foundation/unit",
    "test:c1-foundation:integration": "vitest run --config vitest.config.ts test/c1-foundation/integration",
    "test:c2-ci-cd": "vitest run --coverage --config test/c2-ci-cd/vitest.config.ts",
    "test:c3-event-apis": "vitest run --coverage --config test/c3-event-apis/vitest.config.ts test/c3-event-apis/unit",
    "test:c3-event-apis:integration": "vitest run --config test/c3-event-apis/vitest.config.ts test/c3-event-apis/integration",
    "test:c6-async-monitoring": "vitest run --coverage --config test/c6-async-monitoring/vitest.config.ts",
    "test:c4-ui": "vitest run --coverage --config test/c4-ui/vitest.config.ts test/c4-ui/unit",
    "test:c4-ui:integration": "vitest run --config test/c4-ui/vitest.config.ts test/c4-ui/integration",
    "test:c5-reminders-statistics-archival": "vitest run --coverage --config test/c5-reminders-statistics-archival/vitest.config.ts test/c5-reminders-statistics-archival/unit",
    "test:c5-reminders-statistics-archival:integration": "vitest run --config test/c5-reminders-statistics-archival/vitest.config.ts test/c5-reminders-statistics-archival/integration",
    "test:c7-evidence-release": "vitest run --coverage --config test/c7-evidence-release/vitest.config.ts test/c7-evidence-release/unit",
    "evidence:load-test": "tsx scripts/evidence/load-test-cli.ts",
    "evidence:cleanup": "tsx scripts/evidence/cleanup-evidence-cli.ts",
    "evidence:ses-proof": "tsx scripts/evidence/ses-proof-cli.ts",
    "evidence:cost-notes": "tsx scripts/evidence/cost-notes-cli.ts",
    "evidence:manifest-check": "tsx scripts/evidence/manifest-check-cli.ts",
    "security-audit": "tsx scripts/security-audit.ts",
    "validate": "npm run build && npm run lint && npm run format:check && npm run test:c1-foundation && npm run test:c1-foundation:integration && npm run test:c3-event-apis && npm run test:c3-event-apis:integration && npm run test:c4-ui && npm run test:c4-ui:integration && npm run test:c5-reminders-statistics-archival && npm run test:c5-reminders-statistics-archival:integration && npm run test:c7-evidence-release && npm run evidence:manifest-check && npm run security-audit && npm run prohibited-token-check",
    "synth": "tsx scripts/synth.ts",
    "deploy": "tsx scripts/deploy.ts",
    "health-check": "tsx scripts/health-check.ts",
    "archive-invoke": "tsx scripts/archive-invoke.ts",
    "stats-check": "tsx scripts/stats-check.ts",
    "seed": "tsx src/seed/cli.ts",
    "teardown": "tsx scripts/teardown/cli.ts",
    "prohibited-token-check": "tsx scripts/prohibited-token-check.ts",
    "cdk": "cdk"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "3.1146.0",
    "@aws-sdk/client-cloudfront": "3.1146.0",
    "@aws-sdk/client-cloudwatch": "3.1146.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1146.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1146.0",
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-lambda": "3.1146.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "@aws-sdk/client-sesv2": "3.1146.0",
    "@aws-sdk/client-sqs": "3.1146.0",
    "@aws-sdk/client-sts": "3.1146.0",
    "@aws-sdk/credential-providers": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "@aws-sdk/s3-presigned-post": "3.1146.0",
    "amazon-cognito-identity-js": "6.3.20",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.147",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "4.1.11",
    "aws-cdk": "2.1144.0",
    "cdk-nag": "2.35.32",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "happy-dom": "20.14.5",
    "prettier": "3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
