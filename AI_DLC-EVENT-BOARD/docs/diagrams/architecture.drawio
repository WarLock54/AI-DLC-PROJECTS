          <mxGeometry x="280" y="460" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jToken" value="&lt;b&gt;prohibited-token-check&lt;/b&gt;: case-insensitive banned-word scan of tracked files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="540" width="290" height="60" as="geometry" />
        </mxCell>

        <mxCell id="stDeploy" value="Stage: deploy (main only, resource_group serialises runs)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
