  <diagram id="pipeline" name="CI/CD pipeline">
    <mxGraphModel dx="1400" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ptitle" value="&lt;b&gt;GitLab CI/CD pipeline (.gitlab-ci.yml)&lt;/b&gt;&lt;br&gt;Push to main: validate → deploy → health-check; exits 0 only after the deployed app answers. Merge requests run validate only. Teardown runs only when started manually with TEARDOWN=true." style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="trigger" value="&lt;b&gt;Push / merge to main&lt;/b&gt;&lt;br&gt;(or the course orchestrator's commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FC6D26;strokeColor=#E24329;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="stValidate" value="Stage: validate (jobs run in parallel)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="330" height="560" as="geometry" />
        </mxCell>
        <mxCell id="jLint" value="&lt;b&gt;lint&lt;/b&gt;: tsc build, ESLint, Prettier, evidence manifest check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="130" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jTest" value="&lt;b&gt;test&lt;/b&gt;: unit + integration suites for every unit, 80% line-coverage floor, RSVP concurrency test, CDK assertions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
