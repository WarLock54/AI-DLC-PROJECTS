        </mxCell>
        <mxCell id="jDeploy1" value="1. &lt;b&gt;npm run deploy&lt;/b&gt;: idempotent cdk bootstrap, cdk deploy --require-approval never, output checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="220" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="jDeploy2" value="2. &lt;b&gt;npm run seed&lt;/b&gt;: deterministic synthetic users and events (check before insert)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="305" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jDeploy3" value="3. &lt;b&gt;archive-invoke&lt;/b&gt;: archive the seeded 400-day-old event, prove the S3 object (3 retries)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="380" width="290" height="70" as="geometry" />
