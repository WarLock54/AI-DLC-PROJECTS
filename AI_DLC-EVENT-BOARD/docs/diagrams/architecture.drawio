        <mxCell id="stHealth" value="Stage: health-check" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="200" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="jHealth1" value="&lt;b&gt;health-check&lt;/b&gt;: GET https://{SiteUrl}/api/health must return 200 {&quot;status&quot;:&quot;ok&quot;} (10 tries, 30 s apart)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
