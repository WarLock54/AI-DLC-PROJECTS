        <mxCell id="teardown" value="&lt;b&gt;teardown&lt;/b&gt; (separate pipeline, debug sandbox only)&lt;br&gt;Started by hand with TEARDOWN=true; deletes team32-ceb- stacks and retained resources, then proves the inventory is empty. Never runs on a push." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="1">
